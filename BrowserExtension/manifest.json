{
  "manifest_version": 3,
  "name": "PassSafer",
  "version": "2.1.3",
  "description": "Your intelligent password manager – Autofill, Save & Generate.",
  "homepage_url": "https://zyniotech.github.io/passsafer/",

  "permissions": ["storage", "nativeMessaging", "alarms", "favicon"],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "run_at": "document_end",
      "js": [
        "content/domain-utils.js",
        "content/storage-client.js",
        "content/field-detection.js",
        "content/autofill.js",
        "content/generator.js",
        "content/ui.js",
        "content/content-main.js"
      ]
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon16.png",
        "icons/icon48.png",
        "icons/icon.svg",
        "icons/password.svg",
        "icons/generate.svg",
        "icons/visibility_on.svg",
        "icons/visibility_off.svg",
        "icons/check.svg"
      ],
      "matches": ["<all_urls>"]
    },
    {
      "resources": ["_favicon/*"],
      "matches": ["<all_urls>"],
      "extension_ids": ["*"]
    }
  ]
}
